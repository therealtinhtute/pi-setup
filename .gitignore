# Secrets, caches, machine-local state

# --- Secrets ---
.env
.env.*
*.env
!.env.example
auth.json
antigravity-accounts.json
credentials.json
*.pem
*.key
id_rsa*
id_ed25519*

# --- Machine-local Pi state ---
sessions/
cache/
crashes.json
models-store.json
mcp-onboarding.json
pi-subagents/
browser-profile*
.git/
bin/
npm/
git/

# --- Backups produced by setup/install.sh ---
*.backup.*
*.backup

# --- Vendored extension dependencies (installed by setup/install.sh) ---
extensions/*/node_modules/
extensions/*/dist/

# --- OS / editor noise ---
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# --- Logs ---
*.log

# --- Vendored pi-pretty build output ---
extensions/pi-pretty/dist/
extensions/pi-pretty/coverage/
extensions/pi-pretty/*.tsbuildinfo

# --- Local workflow artifacts (plan locks, session state) ---
.harness/
